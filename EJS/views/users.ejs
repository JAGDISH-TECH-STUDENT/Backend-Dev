      </form>
    <ul>
        <% userData.forEach((ele)=>{ %>
            <li><%= ele.name %> <%= ele.age %> <%= ele.password %> 
                <form action="/api/users/<%=ele.id%>?_method=DELETE" method="POST">
                    <button type="submit">Delete</button>
                </form>
                <button ><a href="/editpage/<%=ele.id%>">Edit</a></button>
            </l1>
                    
        <% }) %>
    </ul>
